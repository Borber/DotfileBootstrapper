#!/usr/bin/env bash

set -u

default_endpoint="https://codestral.mistral.ai/v1/chat/completions"
default_model="codestral-latest"
script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
default_config="$script_dir/../tmux-ai.local.conf"
target_window=""
config_file="${TMUX_AI_CONFIG:-$default_config}"
lock_dir=""
response_file=""
error_file=""

notify() {
  local message="$1"

  if [[ -n "$target_window" ]]; then
    tmux display-message -t "$target_window" "$message" 2>/dev/null || true
  else
    tmux display-message "$message" 2>/dev/null || true
  fi
}

fail() {
  notify "tmux-ai: $1"
  exit 1
}

cleanup() {
  if [[ -n "$lock_dir" ]]; then
    rm -rf "$lock_dir"
  fi

  if [[ -n "$response_file" ]]; then
    rm -f "$response_file"
  fi

  if [[ -n "$error_file" ]]; then
    rm -f "$error_file"
  fi
}

trap cleanup EXIT

read_config_value() {
  local key="$1"
  local file="$2"
  local value

  [[ -f "$file" ]] || return 0

  value=$(awk -v key="$key" '
    /^[[:space:]]*#/ { next }
    {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line ~ ("^" key "[[:space:]]*=")) {
        sub(("^" key "[[:space:]]*=[[:space:]]*"), "", line)
        print line
        exit
      }
    }
  ' "$file")

  value="${value#${value%%[![:space:]]*}}"
  value="${value%${value##*[![:space:]]}}"

  if [[ "$value" == \"* ]]; then
    value="${value#\"}"
    value="${value%\"}"
  elif [[ "$value" == \'* ]]; then
    value="${value#\'}"
    value="${value%\'}"
  fi

  printf '%s' "$value"
}

sanitize_context() {
  LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' |
    awk '
      {
        lower = tolower($0)
        if (lower ~ /(api[-_]?key|access[-_]?token|password|secret|authorization|bearer)/) {
          print "[redacted sensitive line]"
          next
        }

        print
      }
    ' |
    awk '
      BEGIN { total = 0 }
      {
        remaining = 24000 - total
        if (remaining <= 0) {
          exit
        }

        line_length = length($0)
        if (line_length + 1 <= remaining) {
          print
          total += line_length + 1
          next
        }

        print substr($0, 1, remaining)
        exit
      }
    '
}

sanitize_title() {
  local title="$1"

  title=$(printf '%s' "$title" | tr '\r\n' ' ' | tr -d '\000-\010\013\014\016-\037\177')
  title=$(printf '%s' "$title" | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]`"]+//; s/[[:space:]`"]+$//')
  title="${title//-/ }"
  title=$(printf '%s' "$title" | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//')
  title="${title//#/}"
  title="${title//\\/}"
  title="${title:0:32}"

  printf '%s' "$title"
}

if [[ "${1:-}" == "--reset" ]]; then
  target_window="${2:-}"
  [[ -n "$target_window" ]] || fail "window target is required"

  tmux set-window-option -t "$target_window" automatic-rename on || fail "window no longer exists"
  notify "tmux-ai: automatic window naming enabled"
  exit 0
fi

target_window="${1:-}"
[[ -n "$target_window" ]] || fail "window target is required"

lock_root="${TMPDIR:-/tmp}"
lock_name=$(printf '%s' "$target_window" | tr -c '[:alnum:]_.@-' '_')
lock_dir="$lock_root/tmux-ai-name-$lock_name.lock"

if ! mkdir "$lock_dir" 2>/dev/null; then
  if [[ -f "$lock_dir/pid" ]] && ! kill -0 "$(cat "$lock_dir/pid" 2>/dev/null)" 2>/dev/null; then
    rm -rf "$lock_dir"
    mkdir "$lock_dir" 2>/dev/null || fail "another naming request is already running"
  else
    notify "tmux-ai: a naming request is already running"
    exit 0
  fi
fi

printf '%s' "$$" >"$lock_dir/pid"

working_path=$(tmux display-message -p -t "$target_window" '#{pane_current_path}' 2>/dev/null) || fail "window no longer exists"
working_name="${working_path##*/}"
[[ -n "$working_name" ]] || working_name="/"

git_root=$(git -C "$working_path" rev-parse --show-toplevel 2>/dev/null || true)
repo_name=""
git_branch=""
if [[ -n "$git_root" ]]; then
  repo_name="${git_root##*/}"
  git_branch=$(git -C "$working_path" branch --show-current 2>/dev/null || true)
  [[ -n "$git_branch" ]] || git_branch="detached"
fi
project_name="${repo_name:-$working_name}"

configured_api_key=$(read_config_value TMUX_AI_API_KEY "$config_file")
configured_endpoint=$(read_config_value TMUX_AI_ENDPOINT "$config_file")
configured_model=$(read_config_value TMUX_AI_MODEL "$config_file")
configured_max_tokens=$(read_config_value TMUX_AI_MAX_TOKENS "$config_file")
configured_timeout=$(read_config_value TMUX_AI_TIMEOUT "$config_file")
configured_context_lines=$(read_config_value TMUX_AI_CONTEXT_LINES "$config_file")

api_key="${TMUX_AI_API_KEY:-$configured_api_key}"
endpoint="${TMUX_AI_ENDPOINT:-${configured_endpoint:-$default_endpoint}}"
model="${TMUX_AI_MODEL:-${configured_model:-$default_model}}"
max_tokens="${TMUX_AI_MAX_TOKENS:-${configured_max_tokens:-48}}"
timeout="${TMUX_AI_TIMEOUT:-${configured_timeout:-20}}"
context_lines="${TMUX_AI_CONTEXT_LINES:-${configured_context_lines:-200}}"

[[ -n "$api_key" && "$api_key" != your-* ]] || fail "configure TMUX_AI_API_KEY in $config_file"
[[ "$max_tokens" =~ ^[1-9][0-9]*$ ]] || max_tokens=48
[[ "$timeout" =~ ^[1-9][0-9]*$ ]] || timeout=20
[[ "$context_lines" =~ ^[1-9][0-9]*$ ]] || context_lines=200

pane_context=$(tmux list-panes -t "$target_window" \
  -F 'pane=#{pane_index} active=#{pane_active} command=#{pane_current_command} title=#{pane_title} directory=#{b:pane_current_path}' \
  2>/dev/null) || fail "window no longer exists"

active_pane=$(tmux list-panes -t "$target_window" -F '#{pane_id} #{pane_active}' 2>/dev/null | awk '$2 == 1 { print $1; exit }')
[[ -n "$active_pane" ]] || fail "no active pane found"

top_level_entries=$(
  (
    shopt -s nullglob dotglob
    for entry in "$working_path"/*; do
      entry_name="${entry##*/}"
      if [[ -d "$entry" ]]; then
        printf '%s/\n' "$entry_name"
      else
        printf '%s\n' "$entry_name"
      fi
    done
  ) | sort | awk 'NR <= 100'
)
[[ -n "$top_level_entries" ]] || top_level_entries="(empty)"

readme_file=$(
  (
    shopt -s nullglob dotglob
    for entry in "$working_path"/*; do
      entry_name="${entry##*/}"
      lower_entry_name="${entry_name,,}"
      if [[ -f "$entry" && ( "$lower_entry_name" == "readme" || "$lower_entry_name" == readme.* ) ]]; then
        printf '%s\n' "$entry"
        break
      fi
    done
  )
)
readme_context="(none found)"
if [[ -n "$readme_file" ]]; then
  readme_context=$(sed -n '1,60p' "$readme_file" 2>/dev/null | awk '
    BEGIN { total = 0 }
    {
      remaining = 6000 - total
      if (remaining <= 0) {
        exit
      }

      line_length = length($0)
      if (line_length + 1 <= remaining) {
        print
        total += line_length + 1
        next
      }

      print substr($0, 1, remaining)
      exit
    }
  ')
  [[ -n "$readme_context" ]] || readme_context="(empty)"
fi

pane_output=$(tmux capture-pane -p -J -t "$active_pane" -S "-$context_lines" 2>/dev/null || true)
context=$(cat <<EOF_CONTEXT | sanitize_context
Project name: $project_name
Working directory: $working_name
Git branch: ${git_branch:-none}
Top-level entries:
$top_level_entries
README excerpt:
$readme_context
Panes:
$pane_context
Recent active pane output:
$pane_output
EOF_CONTEXT
)

request_body=$(jq -n \
  --arg model "$model" \
  --arg context "$context" \
  --argjson max_tokens "$max_tokens" \
  '{
    model: $model,
    messages: [
      {
        role: "system",
        content: "You name one tmux window from terminal activity. Infer the primary task from the project name, active command, recent output, working directory, branch, top-level project entries, and the README excerpt when available. Use project identity as context, but choose the title that best describes the current activity. Do not force the project name into the title when the activity is already clear. Treat README as supporting project context. Let the active command and recent output override README when they describe a more specific current task. Give the activity a specific, stable title. Prefer the current task over generic names such as shell, terminal, repository, or branch. Return exactly one natural short title, preferably 2 to 4 words and no more than 32 characters. Use spaces between words. Do not use hyphens, colons, slashes, pipes, underscores, quotes, markdown, or newline. Do not repeat a branch name or file name unless it identifies the task. Do not include secrets, usernames, or absolute paths. If the activity is ambiguous, choose the most specific command or project purpose visible in the context."
      },
      {
        role: "user",
        content: $context
      }
    ],
    temperature: 0.2,
    max_tokens: $max_tokens
  }') || fail "could not build API request"

response_file=$(mktemp "${TMPDIR:-/tmp}/tmux-ai-response.XXXXXX") || fail "could not create temporary response file"
error_file=$(mktemp "${TMPDIR:-/tmp}/tmux-ai-error.XXXXXX") || fail "could not create temporary error file"

notify "tmux-ai: naming window..."

http_code=$(curl -sS \
  --connect-timeout 5 \
  --max-time "$timeout" \
  -o "$response_file" \
  -w '%{http_code}' \
  -H 'Content-Type: application/json' \
  -H "Authorization: Bearer $api_key" \
  --data "$request_body" \
  "$endpoint" 2>"$error_file")
curl_status=$?

if ((curl_status != 0)); then
  fail "API request failed"
fi

if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
  fail "API returned HTTP $http_code"
fi

title=$(jq -r '.choices[0].message.content // empty' "$response_file" 2>/dev/null) || fail "API response was not valid JSON"
title=$(sanitize_title "$title")
[[ -n "$title" ]] || fail "API returned an empty title"

tmux set-window-option -t "$target_window" automatic-rename off || fail "window no longer exists"
tmux rename-window -t "$target_window" "$title" || fail "could not rename window"
notify "tmux-ai: window renamed to $title"
