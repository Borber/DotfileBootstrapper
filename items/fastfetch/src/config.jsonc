// DotfileBootstrapper fastfetch theme
// Static ASCII layout adapted from https://github.com/CheikhNaro/ffthemes
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": " ___          _\n| _ ) ___ _ _| |__  ___ _ _\n| _ \\/ _ \\ '_| '_ \\/ -_) '_|\n|___/\\___/_| |_.__/\\___|_|",
    "type": "data",
    "padding": {
      "top": 6,
      "left": 0,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#ffffff",
      "title": "#c6c6c6",
      "separator": "#63c6c6"
    },
    "percent": {
      "type": [
        "num"
      ],
      "color": {
        "green": "#e2e2e2",
        "yellow": "#474747",
        "red": "#ffb4ab"
      }
    },
    "bar": {
      "border": {
        "left": "[",
        "right": "]"
      },
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "width": 10,
      "color": {
        "elapsed": "#e2e2e2",
        "total": "#474747"
      }
    }
  },
  "modules": [
    {
      "key": "┏━━━━━━━━┓",
      "type": "custom"
    },
    {
      "key": "┃ {#34} os   {#keys}┃",
      "type": "os",
      "format": "{pretty-name}"
    },
    {
      "key": "┃ {#35} ker  {#keys}┃",
      "type": "command",
      "text": "uname -r | cut -d'-' -f1"
    },
    {
      "key": "┃ {#36} wm   {#keys}┃",
      "type": "wm",
      "format": "{1}"
    },
    {
      "key": "┃ {#31} term {#keys}┃",
      "type": "terminal",
      "format": "{1}"
    },
    {
      "key": "┃ {#31} shll {#keys}┃",
      "type": "shell",
      "format": "{1}"
    },
    {
      "key": "┃ {#33}󰞌 up   {#keys}┃",
      "type": "uptime"
    },
    {
      "key": "┃ {#32} age  {#keys}┃",
      "type": "command",
      "text": "printf '%s days' \"$(( ($(date +%s) - $(stat -c %W / 2>/dev/null || stat -c %Y /)) / 86400 ))\""
    },
    {
      "key": "┃ {#36}󰍹 scrn {#keys}┃",
      "type": "display"
    },
    {
      "key": "┃ {#35}󰍛 cpu  {#keys}┃",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "┃ {#31}󰢮 gpu  {#keys}┃",
      "type": "gpu"
    },
    {
      "key": "┃ {#36}󰟜 ram  {#keys}┃",
      "type": "memory",
      "format": "{percentage-bar} {percentage} {used} / {total}",
      "percent": {
        "type": [
          "num",
          "bar"
        ]
      }
    },
    {
      "key": "┃ {#33}󰉉 disk {#keys}┃",
      "type": "disk",
      "folders": "/",
      "format": "{size-percentage-bar} {size-percentage} {size-used} / {size-total} - {filesystem}",
      "percent": {
        "type": [
          "num",
          "bar"
        ]
      }
    },
    {
      "key": "┃ {#34}󰁹 bat  {#keys}┃",
      "type": "battery"
    },
    {
      "key": "┃ {#35}󰏖 pkgs {#keys}┃",
      "type": "packages"
    },
    {
      "key": "┃ {#39}      {#keys}┃",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "┗━━━━━━━━┛",
      "type": "custom"
    }
  ]
}
